{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "crons": [
    { "path": "/api/cron-trend", "schedule": "0 * * * *" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": {
      "memory": 256,
      "maxDuration": 60
    },
    "api/cron-trend.js": {
      "memory": 256,
      "maxDuration": 60
    }
  }
}