# 60s API 基础 URL（默认 https://60s.viki.moe）
HOTLIST_BASE_URL=https://60s.viki.moe

# 国内镜像（可选，主域名失败时自动回退）
HOTLIST_MIRROR_URL=

# Vercel Blob 读写令牌（线上必填，本地开发不填则用本地文件系统）
BLOB_READ_WRITE_TOKEN=

# DeepSeek API Key（选题生成必需，仅后端使用，绝不进前端代码）
DEEPSEEK_API_KEY=

# Agent 演示模式：设为 1 时 /api/agent 走假 LLM（不调 DeepSeek、免 key），
# 用于开发前端与理解 Agent 循环；不设或为其他值则走真实 DeepSeek 工具调用
DEEPSEEK_MOCK=

# RAG 向量化提供方：local(本地 bge-small-zh, 首次需联网下模型) / fake(离线确定性, 仅供单测与演示)
#  / zhipu(智谱 embedding-2) / volcengine(火山 doubao-embedding) / openai
# 部署到 Serverless 时务必用 hosted 方（local 冷启动拉 ONNX 会超时）
EMBEDDING_PROVIDER=fake
# hosted 方所需 key（local/fake 不需要）
EMBEDDING_API_KEY=